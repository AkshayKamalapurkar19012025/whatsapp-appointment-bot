# Copy to .env and fill in real values for your environment.
# Never commit a real .env file (it is already gitignored).
# See SETUP.md for the full walkthrough.

# Option A: set a full connection string (libpq keyword/value string or a
# postgresql:// URL). If set, this takes priority over the DB_* fields below.
# DATABASE_URL=postgresql://appointment_bot:password@localhost:5432/appointment_bot

# Option B: set individual parts. DB_NAME/DB_USER default to the values the
# app has always used ("appointment_bot" / "akshaykumar") if left unset.
DB_NAME=appointment_bot
DB_USER=akshaykumar

# Required if using docker-compose.yml (no default is committed on purpose --
# `docker compose up` refuses to start without this set). Optional if your
# local Postgres uses peer/trust auth over the unix socket instead.
DB_PASSWORD=

# Leave blank to connect over the local unix socket (the original default).
# Set to "localhost" if using docker-compose.yml or any TCP-only Postgres.
DB_HOST=
DB_PORT=

# Connection pool sizing.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# Comma-separated browser origins allowed to call this API cross-origin
# (WEB P10). Leave blank if FastAPI serves the frontend same-origin, or
# for local dev via frontend/vite.config.ts's proxy -- neither needs an
# entry here. Required if the frontend is deployed on its own domain/port,
# e.g. ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=

# Optional: real SMS delivery for patient OTP codes via Authkey.io (see
# app/services/sms_provider.py) -- an India-focused SMS/OTP provider.
# Leave both blank to keep using the mock outbox only (the default -- no
# Authkey account needed for local dev/tests). Both must be set together
# for real SMS to send. Get these from https://authkey.io after signing
# up (their Startup plan gives ~10,000 free OTPs to start with):
#   AUTHKEY_API_KEY     - your account's API key, from the dashboard.
#   AUTHKEY_TEMPLATE_ID - the "sid" of a DLT-approved OTP template you
#                         create in the dashboard (Indian telecom
#                         regulation requires the message wording to be
#                         pre-registered; only the OTP code itself is
#                         sent per-request, filled into that template).
AUTHKEY_API_KEY=
AUTHKEY_TEMPLATE_ID=
# Only needed if you ever serve patients outside India -- defaults to 91.
AUTHKEY_COUNTRY_CODE=91

# Optional testing bypass (see app/services/patient_auth.py's verify_otp
# docstring): when set, this fixed code logs in as ANY patient, in
# addition to their real per-number code. Useful for letting someone
# test over a tunnel/public URL without needing real SMS configured --
# tell them this code out of band instead of reading it from
# _dev_lookup yourself. They still have to click "Send OTP" first.
# Leave blank to disable (the default). Automatically disabled whenever
# ENVIRONMENT=production, regardless of this value.
TEST_STATIC_OTP=
