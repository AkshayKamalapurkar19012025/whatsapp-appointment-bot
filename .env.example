# Copy to .env and fill in real values for your environment.
# Never commit a real .env file (it is already gitignored).
# See SETUP.md for the full walkthrough.

# Option A: set a full connection string (libpq keyword/value string or a
# postgresql:// URL). If set, this takes priority over the DB_* fields below.
# DATABASE_URL=postgresql://appointment_bot:password@localhost:5432/appointment_bot

# Option B: set individual parts. DB_NAME/DB_USER default to the values the
# app has always used ("appointment_bot" / "akshaykumar") if left unset.
DB_NAME=appointment_bot
DB_USER=akshaykumar

# Required if using docker-compose.yml (no default is committed on purpose --
# `docker compose up` refuses to start without this set). Optional if your
# local Postgres uses peer/trust auth over the unix socket instead.
DB_PASSWORD=

# Leave blank to connect over the local unix socket (the original default).
# Set to "localhost" if using docker-compose.yml or any TCP-only Postgres.
DB_HOST=
DB_PORT=

# Connection pool sizing.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# Comma-separated browser origins allowed to call this API cross-origin
# (WEB P10). Leave blank if FastAPI serves the frontend same-origin, or
# for local dev via frontend/vite.config.ts's proxy -- neither needs an
# entry here. Required if the frontend is deployed on its own domain/port,
# e.g. ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=

# Optional: real SMS delivery for patient OTP codes via Twilio (see
# app/services/sms_provider.py). Leave all three blank to keep using the
# mock outbox only (the default -- no Twilio account needed for local
# dev/tests). All three must be set together for real SMS to send.
# Get these from https://console.twilio.com:
#   TWILIO_ACCOUNT_SID  - "Account SID" on the console dashboard
#   TWILIO_AUTH_TOKEN   - "Auth Token" on the console dashboard (secret)
#   TWILIO_FROM_NUMBER  - a Twilio phone number capable of SMS, in E.164
#                         form (e.g. +15551234567); trial accounts get one
#                         free number and can only send to numbers you've
#                         verified in the console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
