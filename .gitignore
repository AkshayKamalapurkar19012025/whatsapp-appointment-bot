# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/

# macOS
.DS_Store

# Environment / secrets
.env
.env.*
!.env.example
!.env.production.example

# IDE
.vscode/
.idea/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# Local databases / generated files
*.sqlite
*.sqlite3
*.db

# Uploaded media (doctor profile photos, see app/config.py's MEDIA_ROOT)
/media/
/doctors/

# Editor / backup files
*.save
app/api/booking backup.py

# Cloudflare Tunnel (scripts/start_tunnel.sh) -- credentials, config, and
# logs for a *named* tunnel, if one is ever set up instead of the default
# Quick Tunnel. Quick Tunnels themselves create none of this (no login, no
# cert, no persisted config), but ignore it defensively either way.
.cloudflared/
cloudflared.log
*.pem
cert.pem
tunnel*.log
tunnel*.json
