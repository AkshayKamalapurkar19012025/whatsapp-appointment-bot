# Copy to .env NEXT TO docker-compose.yml on the VM and fill in every
# value below -- `docker compose up` (the app service) refuses to start
# if any of the REQUIRED ones are missing (app/config.py's production
# startup guard, ENVIRONMENT=production). Never commit the real .env
# (already gitignored).
#
# This is the production counterpart to .env.example (local dev, no
# Docker app/nginx services, no ENVIRONMENT set -- see that file and
# SETUP.md). Phase A same-origin topology: nginx is the only public
# entrypoint, reverse-proxying /api and /media to the app container --
# see docker-compose.yml's own top comment for the full picture.

# ---------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------

# Must be exactly "production" -- gates dev-only endpoints (the mock-OTP
# lookup route, app/api/patient_auth.py) and is what makes
# docker-compose.yml's app service and app/config.py's own startup guard
# both fail loudly instead of silently falling back to dev defaults.
ENVIRONMENT=production

# Database. docker-compose.yml wires DB_HOST/DB_PORT to the postgres
# container itself (postgres:5432) regardless of what's set here -- these
# two are still required so the postgres container's own POSTGRES_DB/
# POSTGRES_USER get set consistently (docker-compose.yml reads the same
# variables for that). DB_HOST/DB_PORT below matter only if you ever run
# scripts/ (e.g. migrate.py) from the HOST against the container's
# published port, not from inside the app container.
DB_NAME=appointment_bot
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# The clinic's own IANA timezone (used for display only where no
# specific doctor is in context yet -- see app/config.py's own comment).
# No fallback in production: state it explicitly rather than silently
# inheriting the dev default (which happened to be Asia/Kolkata, but
# that was never meant to be assumed correct for every deployment).
DEFAULT_TIMEZONE=Asia/Kolkata

# Must match docker-compose.yml's media_data volume mount path exactly
# (currently /app/media) -- that's where uploaded doctor profile photos
# actually persist across container restarts/rebuilds. Don't change one
# without the other.
MEDIA_ROOT=/app/media

# ---------------------------------------------------------------------
# OPTIONAL -- same-origin deployment (Phase A) needs neither set
# ---------------------------------------------------------------------

# Leave BLANK. nginx serves the frontend and proxies /api same-origin
# (docker-compose.yml), so the browser never makes a cross-origin
# request and CORSMiddleware (app/main.py) never needs an allowlist
# entry. Only set this if you later split the frontend onto its own
# domain/port instead of nginx's reverse proxy -- see app/config.py's
# ALLOWED_ORIGINS comment for that separate-deploy path.
ALLOWED_ORIGINS=

# Full DSN/URL alternative to the individual DB_* fields above -- if set,
# it takes priority (app/config.py's _build_default_database_url). Not
# used by this file's own docker-compose.yml wiring (which sets DB_HOST/
# DB_PORT/DB_USER/DB_NAME directly), but still respected if you set it.
# DATABASE_URL=postgresql://user:password@postgres:5432/appointment_bot

# Connection pool sizing -- the defaults (1/10) are conservative for a
# single-instance deployment; only raise these if you've actually
# measured a need to.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# Real SMS delivery for patient OTP codes via Authkey.io (see
# app/services/sms_provider.py). Leave both blank to keep the mock
# outbox for now -- fine for a first deploy you're still verifying
# end-to-end (this phase's own golden-path walkthrough), NOT fine before
# real patients start using this. Both must be set together.
AUTHKEY_API_KEY=
AUTHKEY_TEMPLATE_ID=
AUTHKEY_COUNTRY_CODE=91

# Hard-disabled whenever ENVIRONMENT=production regardless of this
# value (app/config.py) -- listed here only so its absence isn't
# mistaken for an oversight. Never set this on a real production VM.
TEST_STATIC_OTP=
